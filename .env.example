# .env.example  (copy to .env locally; never commit .env)
# Loaded by src/config/env.js via dotenv. .env itself is gitignored — only
# this example (with placeholder values) is committed.

# Selects which entry in ENVIRONMENTS (src/config/env.js) global-setup.js
# authenticates against, and should match the Playwright --project you run
# (developer | sandbox | uat).
SF_ENV=developer

# Salesforce username for the OAuth 2.0 JWT Bearer flow (SalesforceAuth.js).
# This user must be pre-authorized on the Connected App / External Client App
# (Setup > App Manager > Manage > Edit Policies > Permitted Users).
SF_USERNAME=you@example.com

# Consumer Key from the Connected App / External Client App. Used as the JWT
# "iss" claim. See README.md for the one-time Connected App setup.
SF_CONSUMER_KEY=connectedAppConsumerKey

# JWT Bearer Flow private key (PEM). Generate the key pair + self-signed cert
# with `npm run generate:jwt-cert` (writes to .certs/, gitignored); upload
# .certs/server.crt to the Connected App's "Use digital signatures" setting.
# Leave this unset locally — env.js reads .certs/server.key directly. Only
# set it here (or as a CI secret) if the key must come from an env var
# instead of a file, e.g. in a pipeline where the PEM is injected as a secret.
# SF_JWT_PRIVATE_KEY=
