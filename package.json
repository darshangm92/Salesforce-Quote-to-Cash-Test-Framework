{
  "name": "sf-cpq-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E automation for Salesforce CPQ (SBQQ) — see README.md to get running and tests/README.md for the suite map. Standard JSON has no comment syntax, so this field is where package.json documents itself.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env SF_ENV=developer playwright test --project=developer",
    "test:sandbox": "cross-env SF_ENV=sandbox playwright test --project=sandbox",
    "test:uat": "cross-env SF_ENV=uat playwright test --project=uat",
    "test:pr": "playwright test --grep-invert \"@type:journey|@quota:heavy|@wip|@skip-de\"",
    "test:smoke": "playwright test --grep \"@type:smoke\" --grep-invert \"@wip|@skip-de\"",
    "test:regression": "playwright test --grep \"@type:regression\" --grep-invert \"@quota:heavy|@wip|@skip-de\"",
    "test:journey": "playwright test tests/journeys --workers=1",
    "test:parallel": "node scripts/run-parallel.js",
    "test:serial": "playwright test --grep \"@serial\" --workers=1",
    "test:keep-data": "cross-env CPQ_SKIP_CLEANUP=1 playwright test",
    "lint:tags": "node scripts/lint-tags.js",
    "ledger:merge": "node scripts/merge-ledger.js",
    "cleanup:e2e": "node scripts/cleanup-e2e-data.js",
    "extract:contract": "node scripts/extract-contract.js",
    "test:chromium": "cross-env BROWSER=chromium playwright test",
    "test:firefox": "cross-env BROWSER=firefox playwright test",
    "test:webkit": "cross-env BROWSER=webkit playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:ci": "node scripts/prepare-allure.js && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "generate:jwt-cert": "node scripts/generate-jwt-cert.js"
  },
  "keywords": [],
  "author": "Darshan",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "xlsx": "^0.18.5"
  }
}
